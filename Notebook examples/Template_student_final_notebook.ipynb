    "### 2c. Use Euler's method to solve the SEIR model.\n",
    "This section should come from your python code after Data Release #2."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "55aaf509",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Euler's method to find SIER model parameters\n",
    "beta = 0.277    # transmission rate\n",
    "sigma = 0.205    # incubation rate\n",
    "gamma = 0.111    # recovery rate\n",
    "h = 1          # time step\n",
    "N = 17900    # total population\n",
    "\n",
    "S = N - 1\n",
    "E = 0\n",
    "I = 1\n",
    "R = 0\n",
    "seir_results = []\n",
    "\n",
    "for virus_day in Virus_count.all_virus_count:\n",
    "\n",
    "\n",
    "    day = virus_day.get_day()\n",
    "\n",
    "    # Euler derivatives\n",
    "    dS = -beta * S * I / N\n",
    "    dE = beta * S * I / N - sigma * E\n",
    "    dI = sigma * E - gamma * I\n",
    "    dR = gamma * I\n",
    "\n",
    "    # Euler updates\n",
    "    S = S + h * dS\n",
    "    E = E + h * dE\n",
    "    I = I + h * dI\n",
    "    R = R + h * dR\n",
    "\n",
    "    seir_results.append((day, S, E, I, R))\n",
    "    import matplotlib.pyplot as plt\n",
    "\n"
   ]
  },

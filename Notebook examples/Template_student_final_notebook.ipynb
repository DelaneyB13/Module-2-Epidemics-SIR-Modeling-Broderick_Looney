     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "# Calulate R0 v1\n",
    "R0_v1 = 1 + popt[1] * 9 # Assuming an infectious period of 9 days\n",
    "print(\"R0_v1:\", R0_v1)\n",
    "\n",
    "#Calculate R0 v2\n",
    "g = np.exp(popt[1])\n",
    "R0_v2 = np.power(g, 9)\n",
    "print(\"R0_v2:\", R0_v2)"
   ]
  },

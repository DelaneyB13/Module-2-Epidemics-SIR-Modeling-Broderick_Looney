   "source": [
    "#### Step 8. Define the exponential function to fit the data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "02a9d57e",
   "metadata": {
    "vscode": {
     "languageId": "plaintext"
    }
   },
   "outputs": [],
   "source": [
    "def exponential_func(x, I0, r):\n",
    "    return I0 * np.exp(r * x)\n",
    "\n",
    "popt, pcov = curve_fit(exponential_func, X, y, p0=(1, 0.1))  # Initial guess for parameters a and b\n",
    "print(\"I0,:\", popt[0], \"r:\", popt[1])\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8984eae7",
   "metadata": {},
   "source": [
    "#### Step 9. Calculate R0 using the two different ways we went over in class"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "743fee38",
   "metadata": {

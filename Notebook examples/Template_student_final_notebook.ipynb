   "outputs": [],
   "source": [
    "def __repr__(self): \n",
    "        return f\"( {self.day} | {self.date} | {self.active_reported_daily_cases})\" \n",
    "    \n",
    "def get_day(self): \n",
    "        return self.day\n",
    "\n",
    "def get_active_reported_daily_cases(self): \n",
    "        return self.active_reported_daily_cases"
